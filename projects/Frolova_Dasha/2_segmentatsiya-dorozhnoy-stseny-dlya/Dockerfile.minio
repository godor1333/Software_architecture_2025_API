FROM golang:1.22-alpine AS build

ARG MINIO_TAG=RELEASE.2024-10-13T13-34-11Z
RUN apk add --no-cache ca-certificates git
RUN git clone --depth 1 --branch "${MINIO_TAG}" https://github.com/minio/minio.git /src
WORKDIR /src
RUN MINIO_RELEASE=RELEASE CGO_ENABLED=0 go build -tags kqueue -trimpath --ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go 2024-10-13T13:34:11Z)" -o /out/minio .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl
COPY --from=build /out/minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
